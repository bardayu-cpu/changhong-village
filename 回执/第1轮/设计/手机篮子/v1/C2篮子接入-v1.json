      "known": "id in state.data.village.blueprints",
      "materials": "cfg.items with state.count(id) numerator",
      "action": {
        "command": "craft",
        "args": {
          "id": "selected furniture key"
        }
      },
      "enabled": "blueprint learned AND all materials available"
    }
  },
  "fixed_actions": {
    "parcel": {
      "when": "selected item == parcel",
      "command": "parcel",
      "args": {},
      "enabled": "state.count(parcel) > 0"
