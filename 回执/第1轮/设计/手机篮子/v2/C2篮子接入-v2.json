  "groups": {
    "items": {
      "source": "state.data.village.items, count > 0",
      "order": "C.ITEMS then unknown save keys",
      "selection": "first existing id; preserve current valid id",
      "ordinary_action": "none"
    },
    "seeds": {
      "source": "C.CROPS",
      "show_zero": true,
      "action": {
        "command": "seed",
        "args": {
          "crop": "selected crop key"
        }
      },
      "enabled": "coins >= C.SEED_COST"
    },
    "plans": {
      "source": "Virtual existing box service card first, then all12 C.FURNITURE entries; service is not owned item or blueprint.",
      "known": "id in state.data.village.blueprints",
      "materials": "cfg.items with state.count(id) numerator",
      "action": {
        "command": "craft",
        "args": {
          "id": "selected furniture key"
        }
      },
      "enabled": "blueprint learned AND all materials available",
      "selection": "Preserve valid id; default first furniture (chair), not box service.",
      "service": {
        "id": "box",
        "display": "Gold blind box, C.BOX_COST price",
        "icon": "reuse parcel artwork",
        "not_inventory": true,
        "not_blueprint": true,
        "selection_does_not_consume": true
      }
    }
  },
  "fixed_actions": {
    "parcel": {
      "when": "selected item == parcel",
      "command": "parcel",
      "args": {},
      "enabled": "state.count(parcel) > 0"
    },
    "box": {
      "when": "plans group AND selected virtual service id == box; no global box button in ordinary selected details.",
      "command": "box",
      "args": {},
      "enabled": "coins >= C.BOX_COST"
    },
    "return": "existing close()"
  },
